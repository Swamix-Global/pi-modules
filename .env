# Configuration lives here; process environment can override it.
PI_CONTEXT_ROUTER_HOST=127.0.0.1
PI_CONTEXT_ROUTER_PORT=4141
PI_CONTEXT_ROUTER_UPSTREAM=https://chatgpt.com/backend-api
PI_CONTEXT_ROUTER_ROUTES='{"openai":"https://api.openai.com/v1","deepseek":"https://api.deepseek.com","openrouter":"https://openrouter.ai/api/v1","groq":"https://api.groq.com/openai/v1","cerebras":"https://api.cerebras.ai/v1","qwen-token-plan":"https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1","xiaomi-token-plan-sgp":"https://token-plan-sgp.xiaomimimo.com/v1","lmstudio":"http://127.0.0.1:1234/v1"}'
PI_CONTEXT_ROUTER_DB=~/.pi/agent/ctx-engine-v2.db
PI_CONTEXT_ROUTER_AUTH=~/.pi/agent/auth.json
PI_CONTEXT_ROUTER_API_KEY=
PI_CONTEXT_ROUTER_TOKENS=32000
PI_CONTEXT_ROUTER_KEEP_TURNS=2
PI_CONTEXT_ROUTER_CONDENSER_URL=https://api.deepseek.com/chat/completions
PI_CONTEXT_ROUTER_CONDENSER_MODEL=deepseek-flash
PI_CONTEXT_ROUTER_MAX_TOKENS=8192
PI_CONTEXT_ROUTER_ATTEMPT_TIMEOUT=30
PI_CONTEXT_ROUTER_MAX_BODY_BYTES=134217728
PI_CONTEXT_ROUTER_BLOCK_PROMPT="Summarize one completed assistant activity block into a concise factual note. Preserve exact commands, files, identifiers, decisions, tool results, failures and unresolved work. The user query stays verbatim in a separate user message. Output only the assistant note. Never add tags, wrappers or metadata."
